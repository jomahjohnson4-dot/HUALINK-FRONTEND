# Frontend environment template.
# Copy to `.env` and fill in the values for your machine.

# The Express backend that serves the REST API. The `/api` prefix is applied
# automatically, so either form works.
VITE_API_URL=http://localhost:5000/api

# Mapbox GL public access token used by the live delivery map.
#
# This is a PUBLIC token — it ships in the browser bundle, so it must be a
# restricted (URL allow-listed) public token and never a secret token.
# Without it the tracking page renders the static route schematic instead of
# the interactive Mapbox canvas.
VITE_MAPBOX_ACCESS_TOKEN=

# Optional restricted fallback token, used when VITE_MAPBOX_ACCESS_TOKEN is
# not set (for example on a preview deployment).
VITE_MAPBOX_FALLBACK_TOKEN=
