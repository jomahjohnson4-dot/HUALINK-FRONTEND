VITE_API_BASE_URL=http://localhost:5000/api

# Mapbox GL — public access token for the live delivery map.
#
# A Mapbox token is PUBLIC: it is embedded in the browser bundle and visible
# to anyone, so it is never a secret. Create a restricted public token in the
# Mapbox account with a URL allow-list covering only the Hualink domains and
# scoped to the styles the app uses.
#
# Leave it empty to run the app without the interactive canvas — the tracking
# page then falls back to the static route schematic (see src/config/mapbox.js).
VITE_MAPBOX_ACCESS_TOKEN=
